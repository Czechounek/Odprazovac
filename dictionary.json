  },
  "patterns": {
    "adj_ej_to_y": {
      "pattern": "ej$",
      "replacement": "ý",
      "description": "Přípony -ej → -ý"
    },
    "adj_long_ej_to_y": {
      "pattern": "éj$",
      "replacement": "ý",
      "description": "Přípony -éj → -ý"
    },
    "adj_long_eej_to_y": {
      "pattern": "ééj$",
      "replacement": "ý",
      "description": "Přípony -ééj → -ý"
    },
    "adj_enej_to_eny": {
      "pattern": "enej$",
      "replacement": "ený",
      "description": "Přípony -enej → -ený (otevřenej → otevřený)"
    },
    "adj_ovy_to_ovej": {
      "pattern": "ovej$",
      "replacement": "ový",
      "description": "Přípony -ovej → -ový (základovej → základový)"
    },
    "adj_ici_to_ici": {
      "pattern": "icí$",
      "replacement": "icí",
      "description": "Zachování přípony (spící)"
    },
    "verb_vom_to_om": {
      "pattern": "^vo(m|n|d|p|b)",
      "replacement": "o$1",
      "description": "Odstranění předpony vo- (vokno → okno, vod → od)"
    },
    "pron_von_to_on": {
      "pattern": "^vo(n|na|no|ni|ny)",
      "replacement": "o$1",
      "description": "Zájmeno vo- → o- (vona → ona, von → on)"
    },
    "past_masc_no_l": {
      "pattern": "(řek|moh|pích|nes)$",
      "replacement": "$1l",
      "description": "Doplnění -l u příčestí minulého (řek → řekl, moh → mohl, pích → píchl)"
    }
  },
